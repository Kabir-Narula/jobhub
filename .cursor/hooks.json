{
  "version": 1,
  "hooks": {
    "beforeReadFile": [
      {
        "command": "node .cursor/hooks/deny-secrets.cjs",
        "failClosed": true
      }
    ],
    "beforeTabFileRead": [
      {
        "command": "node .cursor/hooks/deny-secrets.cjs",
        "failClosed": true
      }
    ],
    "beforeShellExecution": [
      {
        "command": "node .cursor/hooks/deny-dangerous-shell.cjs",
        "failClosed": true
      }
    ]
  }
}
